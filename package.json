{
  "name": "salon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "dev:admin": "vite --config vite.admin.config.js --port 5174",
    "dev:delivery": "vite --config vite.delivery.config.js --port 5175",
    "dev:backend": "node server/server.js",
    "dev:all": "concurrently -k -p \"[{name}]\" -n \"BACKEND,USER,ADMIN,DELIVERY\" -c \"cyan,magenta,green,blue\" \"npm run dev:backend\" \"npm run dev\" \"npm run dev:admin\" \"npm run dev:delivery\"",
    "build": "vite build && vite build --config vite.admin.config.js && vite build --config vite.delivery.config.js && node -e \"require('fs').copyFileSync('dist/user-portal/index.html', 'dist/index.html')\" && node -e \"const fs = require('fs'); fs.cpSync('api', 'dist/api', { recursive: true }); fs.cpSync('server', 'dist/server', { recursive: true })\"",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "powershell -ExecutionPolicy Bypass -File start.ps1",
    "server:restart": "powershell -ExecutionPolicy Bypass -File restart-server.ps1"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "canvas-confetti": "^1.9.4",
    "cloudinary": "^2.5.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "framer-motion": "^12.42.2",
    "helmet": "^7.1.0",
    "html2canvas-pro": "^2.4.0",
    "html2pdf.js": "^0.14.0",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "mongoose": "^8.3.1",
    "multer": "^1.4.5-lts.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.3",
    "oxlint": "^1.69.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^6.0.11"
  }
}
