{
  "name": "salon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "dev:admin": "vite --config vite.admin.config.js --port 5174",
    "dev:backend": "node server/server.js",
    "dev:all": "concurrently -k -p \"[{name}]\" -n \"BACKEND,USER,ADMIN\" -c \"cyan,magenta,green\" \"npm run dev:backend\" \"npm run dev\" \"npm run dev:admin\"",
    "build": "vite build && vite build --config vite.admin.config.js",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "powershell -ExecutionPolicy Bypass -File start.ps1",
    "server:restart": "powershell -ExecutionPolicy Bypass -File restart-server.ps1"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "html2pdf.js": "^0.14.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.3",
    "oxlint": "^1.69.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^6.0.11"
  }
}
