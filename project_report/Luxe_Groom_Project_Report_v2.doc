<h2>Appendix B: Code Snapshots</h2>
<h3>1. Database Connection (MongoDB)</h3>
<pre><code class="language-javascript">import mongoose from &#39;mongoose&#39;;

const connectDB = async () =&gt; {
  try {
    const conn = await mongoose.connect(process.env.MONGO_URI, {
      useNewUrlParser: true,
      useUnifiedTopology: true,
    });
    console.log(`MongoDB Connected: ${conn.connection.host}`);
  } catch (error) {
    console.error(`Error: ${error.message}`);
    process.exit(1);
  }
};

export default connectDB;
</code></pre>
<h3>2. Express Server Setup (server.js)</h3>
<pre><code class="language-javascript">import express from &#39;express&#39;;
import cors from &#39;cors&#39;;
import dotenv from &#39;dotenv&#39;;
import connectDB from &#39;./config/db.js&#39;;

dotenv.config();
connectDB();

const app = express();
app.use(cors());
app.use(express.json());

const PORT = process.env.PORT || 5000;
app.listen(PORT, () =&gt; {
  console.log(`Server running on port ${PORT}`);
});
</code></pre>
<h3>3. React Component Example (Customer Dashboard)</h3>
<pre><code class="language-jsx">import React, { useEffect, useState } from &#39;react&#39;;
import axios from &#39;axios&#39;;

const Dashboard = () =&gt; {
  const [appointments, setAppointments] = useState([]);

  useEffect(() =&gt; {
    const fetchAppointments = async () =&gt; {
      try {
        const { data } = await axios.get(&#39;/api/auth/appointments&#39;);
        setAppointments(data.data);
      } catch (error) {
        console.error(&#39;Error fetching appointments&#39;, error);
      }
    };
    fetchAppointments();
  }, []);

  return (
    &lt;div className=&quot;dashboard&quot;&gt;
      &lt;h2&gt;Your Appointments&lt;/h2&gt;
      &lt;ul&gt;
        {appointments.map((apt) =&gt; (
          &lt;li key={apt._id}&gt;{apt.serviceName} - {apt.date}&lt;/li&gt;
        ))}
      &lt;/ul&gt;
    &lt;/div&gt;
  );
};

export default Dashboard;
</code></pre>
