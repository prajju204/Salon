{
  "buildCommand": "npm run build",
  "functions": {
    "api/all.js": {
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/all"
    },
    {
      "src": "/admin-portal/(.*)",
      "dest": "/admin-portal/$1"
    },
    {
      "src": "/delivery-portal/(.*)",
      "dest": "/delivery-portal/$1"
    },
    {
      "src": "/admin(/.*)?",
      "dest": "/admin-portal/index.html"
    },
    {
      "src": "/delivery(/.*)?",
      "dest": "/delivery-portal/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/user-portal/index.html"
    }
  ]
}