{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin-portal/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin-portal/index.html"
    },
    {
      "source": "/((?!api|admin|assets).*\\.[^/\\s]+)$",
      "destination": "/$1"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
