{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/favicon.svg",
      "destination": "/favicon.svg"
    },
    {
      "source": "/icons.svg",
      "destination": "/icons.svg"
    },
    {
      "source": "/admin-portal/:path*",
      "destination": "/admin-portal/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin-portal/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin-portal/index.html"
    },
    {
      "source": "/((?!assets|favicon.svg|icons.svg).*)",
      "destination": "/user-portal/index.html"
    }
  ]
}
