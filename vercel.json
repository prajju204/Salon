{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/admin-portal/:path*",
      "destination": "/admin-portal/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin-portal/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin-portal/index.html"
    },
    {
      "source": "/user-portal/:path*",
      "destination": "/user-portal/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/user-portal/index.html"
    }
  ]
}
