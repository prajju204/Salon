{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin-portal/:path*",
      "destination": "/admin-portal/index.html"
    },
    {
      "source": "/admin/((?!.*\\.).*)",
      "destination": "/admin-portal/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin-portal/index.html"
    },
    {
      "source": "/user-portal/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api|assets|admin|admin-portal|user-portal)[^\\.]*)",
      "destination": "/index.html"
    }
  ]
}
