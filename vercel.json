{
  "cleanUrls": true,
  "buildCommand": "npm run build",
  "functions": {
    "api/all.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/all"
    },
    {
      "source": "/admin/:path*",
      "destination": "/dist/admin-portal/index.html"
    },
    {
      "source": "/delivery/:path*",
      "destination": "/dist/delivery-portal/index.html"
    },
    {
      "source": "/assets/:path*",
      "destination": "/dist/assets/:path*"
    },
    {
      "source": "/favicon.svg",
      "destination": "/dist/favicon.svg"
    },
    {
      "source": "/icons.svg",
      "destination": "/dist/icons.svg"
    },
    {
      "source": "/((?!api|admin|delivery|dist).*)",
      "destination": "/dist/index.html"
    }
  ]
}
